APP_ORIGIN=http://localhost:3000
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Use a unique password of at least 16 characters.
ADMIN_PASSWORD=000
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Super Admin
REGISTRATION_FIRST_NAME=
REGISTRATION_LAST_NAME=
REGISTRATION_EMAIL=
DATA_DIR=./data
BROWSER_EXECUTABLE=
BROWSER_HEADLESS=false
DESKTOP_ENABLED=false
# Optional phone alerts when Zoom asks for human verification (ntfy app). Use a long, unguessable topic
# or a self-hosted ntfy server with a token: public ntfy.sh topics are readable by anyone who knows the name.
ALERT_NTFY_URL=
ALERT_NTFY_TOKEN=
# Initial weekly registration URLs. Kept out of Git. Editable in the private panel.
MEETING_URL_SUNDAY=
MEETING_URL_MONDAY=
MEETING_URL_TUESDAY=
MEETING_URL_WEDNESDAY=
MEETING_URL_THURSDAY=
MEETING_URL_FRIDAY=
MEETING_URL_SATURDAY_AM=
MEETING_URL_SATURDAY_PM=
